{
    "name": "@kalystrum/github-workflows",
    "version": "1.0.0",
    "description": "Centralized GitHub Actions workflows with self-hosted fallback for Kalystrum organization. Provides reusable CI/CD, branch policies, and PR automation across all repos.",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "lint": "eslint .",
        "format": "prettier --write .",
        "format-check": "prettier --check .",
        "typecheck": "tsc --noEmit",
        "test": "tsx --test test/*.test.ts",
        "test:coverage": "tsx --test --experimental-test-coverage test/*.test.ts"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/Kalystrum/.github.git"
    },
    "keywords": [
        "github-actions",
        "ci-cd",
        "workflows",
        "self-hosted-runner",
        "kalystrum",
        "organization"
    ],
    "author": "Developer Riyansh",
    "license": "Proprietary",
    "devDependencies": {
        "@eslint/js": "^9.39.1",
        "@types/node": "^22.20.1",
        "eslint": "^9.39.1",
        "js-yaml": "^5.2.1",
        "prettier": "^3.9.4",
        "tsx": "^4.23.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.63.0"
    }
}
